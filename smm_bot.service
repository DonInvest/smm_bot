# Копируй в /etc/systemd/system/ и включи автозапуск:
#   sudo cp smm_bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable smm_bot
#   sudo systemctl start smm_bot
# Логи: journalctl -u smm_bot -n 80 --no-pager
#
# Не копируй как есть с User=YOUR_USER — сервис упадёт. Ниже вариант для VPS от root.
# У root домашний каталог это /root, не /home/root.

[Unit]
Description=SMM Telegram bot (X + Farcaster)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/smm_bot
ExecStart=/root/smm_bot/venv/bin/python3 -u main.py
Restart=always
RestartSec=15
StartLimitIntervalSec=0
TimeoutStopSec=45
KillMode=mixed
Environment=PYTHONUNBUFFERED=1

# Если бот не в /root/smm_bot или не root — поправь три строки выше, например:
# User=ubuntu
# WorkingDirectory=/home/ubuntu/smm_bot
# ExecStart=/home/ubuntu/smm_bot/venv/bin/python3 -u main.py

[Install]
WantedBy=multi-user.target
